#!/bin/bash
# Pre-push hook:
#   → dev:    ejecuta PHPUnit (aborta si fallan)
#   → main:   bumea version.php y commitea antes de pushear

MOODLE_ROOT="/Users/sergiocomeron/moodles/stable_405/moodle"
TESTSUITE="local_recibeexamen_testsuite"
REPO_ROOT=$(pwd)

while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/dev)
            echo ">>> PHPUnit: local_recibeexamen"
            cd "$MOODLE_ROOT" || exit 1
            vendor/bin/phpunit --testsuite "$TESTSUITE"
            STATUS=$?
            cd "$REPO_ROOT"
            if [ $STATUS -ne 0 ]; then
                echo "Tests failed. Push to dev aborted."
                exit 1
            fi
            echo "Tests passed."
            ;;
        refs/heads/main)
            echo ">>> Bumping version before push to main..."

            TODAY=$(date +%Y%m%d)
            CURRENT_BUILD=$(grep -E '\$plugin->version' version.php | grep -oE '[0-9]{10}')
            CURRENT_DATE=${CURRENT_BUILD:0:8}
            CURRENT_SEQ=${CURRENT_BUILD:8:2}
            if [ "$CURRENT_DATE" = "$TODAY" ]; then
                NEW_SEQ=$(printf "%02d" $((10#$CURRENT_SEQ + 1)))
            else
                NEW_SEQ="01"
            fi
            NEW_BUILD="${TODAY}${NEW_SEQ}"

            CURRENT_RELEASE=$(grep -E "release\s*=" version.php | grep -oE "[0-9]+\.[0-9]+\.[0-9]+")
            MAJOR=$(echo "$CURRENT_RELEASE" | cut -d. -f1)
            MINOR=$(echo "$CURRENT_RELEASE" | cut -d. -f2)
            PATCH=$(echo "$CURRENT_RELEASE" | cut -d. -f3)
            NEW_RELEASE="${MAJOR}.${MINOR}.$((PATCH + 1))"

            sed -i '' -E "s/(version[[:space:]]*=[[:space:]]*)[0-9]{10}/\1${NEW_BUILD}/" version.php
            sed -i '' -E "s/(release[[:space:]]*=[[:space:]]*')[^']+'/\1${NEW_RELEASE}'/" version.php

            git add version.php
            git commit -m "chore: bump version to ${NEW_RELEASE}"

            echo ">>> Version bumped to ${NEW_RELEASE} (build ${NEW_BUILD})"
            ;;
    esac
done

exit 0
